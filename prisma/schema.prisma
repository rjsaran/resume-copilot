// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  ANALYZED
  APPLIED
  RECRUITER_CALL
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum ResumeVersionType {
  MASTER
  TAILORED
}

model Application {
  id                   String            @id @default(cuid())
  userId               String
  company              String
  jobTitle             String
  jobUrl               String
  jobHash              String
  status               ApplicationStatus @default(ANALYZED)
  overallScore         Int
  atsScore             Int
  interviewProbability Int
  verdict              String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  analysis       Analysis?
  resumeVersions ResumeVersion[]
  outcomes       Outcome[]

  @@unique([userId, jobHash])
  @@index([userId])
}

model Analysis {
  id            String   @id @default(cuid())
  applicationId String   @unique
  jdMarkdown    String
  analysisJson  String
  model         String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ResumeVersion {
  id            String            @id @default(cuid())
  applicationId String
  name          String
  type          ResumeVersionType
  resumeJson    String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Outcome {
  id            String   @id @default(cuid())
  applicationId String
  stage         String
  notes         String?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

enum LlmProvider {
  GEMINI
  CLAUDE
  OPENAI
}

/// One row per Supabase-authenticated user. userId is the Supabase auth
/// user's UUID (auth.users.id) — stored as a plain string since Supabase
/// Auth and this app's data live in separate Postgres databases (Neon vs
/// the Supabase project's own database), so there is no DB-level FK here.
model UserSettings {
  id                  String      @id @default(cuid())
  userId              String      @unique
  activeProvider      LlmProvider @default(GEMINI)
  encryptedGeminiKey  String?
  encryptedClaudeKey  String?
  encryptedOpenAiKey  String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

/// One row per user: their full career knowledge base as JSON (see
/// types/careerKnowledgeBase.ts). Replaces the old single, file-based
/// resume/career_knowledge_base.json now that the app is multi-user.
model KnowledgeBase {
  id        String   @id @default(cuid())
  userId    String   @unique
  dataJson  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
